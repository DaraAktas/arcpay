{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ArcPay.CustomerApi",
    "Audience": "ArcPay"
  },
  "ReverseProxy": {
    "Routes": {
      "customer-register-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -10,
        "Match": {
          "Path": "/api/customer/register",
          "Methods": [ "POST" ]
        }
      },
      "customer-login-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -10,
        "Match": {
          "Path": "/api/customer/login",
          "Methods": [ "POST" ]
        }
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/customer/{**catch-all}"
        }
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/wallet/{**catch-all}"
        }
      },
      "transaction-route": {
        "ClusterId": "wallet-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/transaction/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}
